{
  "id": "./",
  "name": "ColorNest",
  "short_name": "ColorNest",
  "description": "Your personal coloring-page library.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#6500c9",
  "categories": ["lifestyle", "education", "productivity"],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared-files",
          "accept": ["application/pdf"]
        }
      ]
    }
  },
  "icons": [
    { "src": "icons/colornest.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
